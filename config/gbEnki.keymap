#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <220>; };

&lt { tapping-term-ms = <150>; };

&mt { quick_tap_ms = <220>; };

&mt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        a1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
        };

        a2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        b1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 15>;
        };

        b2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 21>;
        };

        c1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 27>;
        };

        c2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 32>;
        };

        d1 {
            bindings = <&kp BACKSLASH>;
            key-positions = <17 16>;
        };

        d2 {
            bindings = <&kp PIPE>;
            key-positions = <18 19>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <18 17>;
        };

        get_bt {
            bindings = <&mo 4>;
            key-positions = <36 41>;
        };

        e1 {
            bindings = <&kp LESS_THAN>;
            key-positions = <27 26>;
        };

        e2 {
            bindings = <&kp GREATER_THAN>;
            key-positions = <32 33>;
        };

        esq_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <3 4>;
        };

        del_combo {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        rus_letter_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 7>;
        };

        rus_letter_2 {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 23>;
        };

        rus_letter_3 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <35 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none  &kp Q           &kp W           &kp E                &kp R               &kp T          &kp Y        &kp U                &kp I              &kp O            &kp P                    &none
&none  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D     &mt LEFT_CONTROL F  &kp G          &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON  &none
&none  &kp Z           &kp X           &kp C                &kp V               &kp B          &kp N        &kp M                &kp COMMA          &kp DOT          &kp FSLH                 &none
                                       &mt LEFT_GUI ESCAPE  &mt LEFT_ALT TAB    &lt 1 SPACE    &lt 2 ENTER  &kp BACKSPACE        &lt 3 DEL
            >;
        };

        nav {
            bindings = <
&none  &kp ESCAPE    &mkp RCLK       &mmv MOVE_UP          &mkp LCLK             &msc SCRL_DOWN    &kp HOME         &kp PAGE_DOWN    &kp PAGE_UP      &kp END     &kp LEFT_BRACKET   &none
&none  &mkp MCLK     &mmv MOVE_LEFT  &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &msc SCRL_UP      &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW     &kp RIGHT   &kp SINGLE_QUOTE   &none
&none  &kp CAPSLOCK  &kp LC(LS(N1))  &kp LS(LC(NUMBER_2))  &kp LS(LC(NUMBER_3))  &kp CAPSLOCK      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp INSERT  &kp RIGHT_BRACKET  &none
                                     &none                 &trans                &trans            &mkp LCLK        &mkp MCLK        &mkp RCLK
            >;
        };

        sym {
            bindings = <
&kp LWIN   &kp C_VOL_UP  &kp PG_UP  &kp C_PP       &kp HOME  &kp C_PAUSE    &kp N0     &kp HOME  &kp C_PP  &kp PG_UP  &kp C_VOL_UP  &kp RWIN
&kp LCTRL  &kp C_VOL_DN  &kp LEFT   &kp UP         &kp DOWN  &kp RIGHT      &kp LEFT   &kp DOWN  &kp UP    &kp RIGHT  &kp C_VOL_DN  &kp RALT
&kp LALT   &kp C_MUTE    &kp PG_DN  &kp LG(LS(S))  &kp END   &kp C_PLAY     &kp N0     &kp END   &grtsgn   &kp PG_DN  &kp C_MUTE    &kp RALT
                                    &trans         &trans    &lt 4 RET      &lt 4 ESC  &trans    &trans
            >;
        };

        func {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bt {
            bindings = <
&bootloader        &none         &none         &none         &none  &none         &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &none         &none         &bootloader
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none         &none         &none         &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&ext_power EP_OFF  &kp KP_NUM    &none         &none         &none  &check_bat    &check_bat    &none         &none         &none         &none         &ext_power EP_OFF
                                               &trans        &none  &trans        &trans        &none         &trans
            >;
        };
    };
};
