#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <220>; };

&lt { tapping-term-ms = <150>; };

&mt { quick_tap_ms = <220>; };

&mt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        a1 {
            bindings = <&kp LS(KP_NUMBER_0)>;
            key-positions = <16 15>;
        };

        a2 {
            bindings = <&kp LS(KP_NUMBER_1)>;
            key-positions = <19 20>;
        };

        b1 {
            bindings = <&kp LS(KP_NUMBER_2)>;
            key-positions = <14 15>;
        };

        b2 {
            bindings = <&kp LS(KP_NUMBER_3)>;
            key-positions = <20 21>;
        };

        c1 {
            bindings = <&kp LS(KP_NUMBER_4)>;
            key-positions = <28 27>;
        };

        c2 {
            bindings = <&kp LS(KP_NUMBER_5)>;
            key-positions = <31 32>;
        };

        d1 {
            bindings = <&kp LS(KP_NUMBER_8)>;
            key-positions = <17 16>;
        };

        d2 {
            bindings = <&kp LS(KP_NUMBER_9)>;
            key-positions = <18 19>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <18 17>;
        };

        get_bt {
            bindings = <&mo 4>;
            key-positions = <36 41>;
        };

        e1 {
            bindings = <&kp LS(KP_NUMBER_6)>;
            key-positions = <27 26>;
        };

        e2 {
            bindings = <&kp LS(KP_NUMBER_7)>;
            key-positions = <32 33>;
        };

        esq_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <3 4>;
        };

        del_combo {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        rus_letter_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <7 10>;
        };

        rus_letter_2 {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 22>;
        };

        rus_letter_3 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 34>;
        };

        left_bt {
            bindings = <&mo 4>;
            key-positions = <36 37>;
        };

        right_bt {
            bindings = <&mo 4>;
            key-positions = <41 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none  &kp Q           &kp W           &kp E                &kp R               &kp T          &kp Y        &kp U                &kp I              &kp O            &kp P                    &none
&none  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D     &mt LEFT_CONTROL F  &kp G          &kp H        &mt RIGHT_CONTROL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON  &none
&none  &kp Z           &kp X           &kp C                &kp V               &kp B          &kp N        &kp M                &kp COMMA          &kp DOT          &kp SLASH                &none
                                       &mt LEFT_GUI ESCAPE  &mt LEFT_ALT TAB    &lt 5 SPACE    &lt 6 ENTER  &kp BACKSPACE        &lt 3 DEL
            >;
        };

        nav {
            bindings = <
&none  &kp ESCAPE    &mkp RCLK       &mmv MOVE_UP          &mkp LCLK             &msc SCRL_DOWN    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END     &kp LEFT_BRACKET   &none
&none  &mkp MCLK     &mmv MOVE_LEFT  &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &msc SCRL_UP      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT   &kp SINGLE_QUOTE   &none
&none  &kp CAPSLOCK  &kp LC(LS(N1))  &kp LS(LC(NUMBER_2))  &kp LS(LC(NUMBER_3))  &kp CAPSLOCK      &none           &none           &none         &kp INSERT  &kp RIGHT_BRACKET  &none
                                     &none                 &none                 &trans            &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        sym {
            bindings = <
&none  &kp NUMBER_4  &kp NUMBER_2  &kp NUMBER_3       &kp NUMBER_1   &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_0    &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_7     &none
&none  &kp CARET     &kp TILDE     &kp DOUBLE_QUOTES  &kp COLON      &kp AMPERSAND    &kp PLUS      &kp MINUS       &kp ASTERISK  &kp AT_SIGN   &kp EXCLAMATION  &none
&none  &kp CAPSLOCK  &kp GRAVE     &kp SINGLE_QUOTE   &kp SEMICOLON  &kp DOLLAR       &kp EQUAL     &kp UNDERSCORE  &kp HASH      &kp PERCENT   &kp QUESTION     &none
                                   &kp BACKSPACE      &kp COMMA      &kp PERIOD       &trans        &none           &none
            >;
        };

        func {
            bindings = <
&none  &kp F4  &kp F2  &kp F3  &kp F1  &kp F5                  &kp F6             &kp F10     &kp F8            &kp F9          &kp F7   &none
&none  &none   &none   &none   &none   &kp C_BRIGHTNESS_INC    &kp C_VOLUME_UP    &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &kp F11  &none
&none  &none   &none   &none   &none   &kp C_BRIGHTNESS_DEC    &kp C_VOLUME_DOWN  &kp C_MUTE  &none             &kp LG(LC(Q))   &kp F12  &none
                       &none   &none   &none                   &none              &none       &none
            >;
        };

        bt {
            bindings = <
&none  &bootloader   &none         &out OUT_TOG  &out OUT_USB  &out OUT_BLE    &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &none         &bootloader   &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR      &bt BT_CLR    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none  &none         &none         &none         &none         &check_bat      &check_bat    &none         &none         &none         &none         &none
                                   &none         &none         &none           &none         &none         &none
            >;
        };

        nav_spec {
            bindings = <
&none  &kp ESCAPE  &kp F17         &kp F21               &kp F18               &kp F20         &kp HOME        &kp PAGE_DOWN      &kp PAGE_UP       &kp END     &kp LEFT_BRACKET   &none
&none  &kp F15     &kp F22         &kp F23               &kp F24               &kp F19         &kp LEFT_ARROW  &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT   &kp SINGLE_QUOTE   &none
&none  &kp F14     &kp LC(LS(N1))  &kp LS(LC(NUMBER_2))  &kp LS(LC(NUMBER_3))  &kp CAPSLOCK    &kp LC(LG(A))   &kp LC(LA(SPACE))  &kp LC(UP_ARROW)  &kp INSERT  &kp RIGHT_BRACKET  &none
                                   &none                 &none                 &trans          &kp F18         &kp F16            &kp F17
            >;
        };

        sym_spec {
            bindings = <
&none  &kp NUMBER_4     &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_1     &kp NUMBER_5       &kp NUMBER_6  &kp NUMBER_0    &kp NUMBER_8  &kp NUMBER_9      &kp NUMBER_7     &none
&none  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4    &kp PLUS      &kp MINUS       &kp ASTERISK  &kp LS(KP_MINUS)  &kp LS(KP_PLUS)  &none
&none  &kp CAPSLOCK     &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8    &kp EQUAL     &kp UNDERSCORE  &kp KP_DOT    &kp PERCENT       &kp LS(KP_DOT)   &none
                                         &kp BACKSPACE    &kp KP_MINUS     &kp KP_PLUS        &trans        &none           &none
            >;
        };
    };
};
